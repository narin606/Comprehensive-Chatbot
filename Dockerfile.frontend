FROM node:18-alpine as build

WORKDIR /app

COPY frontend-next/package.json frontend-next/package-lock.json ./
RUN npm install --legacy-peer-deps

COPY frontend-next ./
RUN npm run build

FROM node:18-alpine
WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /app .

EXPOSE 3000

CMD ["npm", "run", "start"]
